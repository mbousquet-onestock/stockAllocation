# Postgres connection string (set automatically on Vercel by the Neon / Postgres integration).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional shared secret: when set, the app must send it (Settings → Database → API key).
API_KEY=
# Key used to encrypt the OneStock passwords saved in the database (recommended). Changing it requires typing them again.
CREDENTIALS_SECRET=
# OneStock UI Extension: secret(s) of the extension given by OneStock (comma separated during a rotation).
ONESTOCK_EXTENSION_SECRET=
# Optional: expected extension ID, and sites allowed to open the extension (comma separated).
ONESTOCK_EXTENSION_ID=
ONESTOCK_EXTENSION_SITES=
# Optional: key signing the sessions of the extension (otherwise a random key saved in the database).
SESSION_SECRET=
